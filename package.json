{
  "name": "docx-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:worker": "cd worker && npm run dev",
    "dev:all": "concurrently -n fe,be -c blue,green \"npm run dev\" \"npm run dev:worker\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
